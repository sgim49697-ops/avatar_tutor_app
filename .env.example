# Avatar Tutor POC runtime settings
APP_NAME="Avatar Tutor POC"
APP_ENV=local
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Empty DATABASE_URL uses the in-memory repository for fastest POC iteration.
# For Postgres+pgvector, run docker compose and set:
# DATABASE_URL=postgresql://avatar:avatar@localhost:5432/avatar_tutor
DATABASE_URL=
AUTO_MIGRATE=false

# local = call local OSS adapters; mock = deterministic smoke-test mode.
MODEL_MODE=local
MODEL_FALLBACK_ENABLED=true
MODEL_DEVICE=cuda

STT_MODEL_NAME=large-v3-turbo
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# OpenAI-compatible local endpoint, e.g. vLLM/llama.cpp/Ollama bridge serving Qwen3-8B.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL_NAME=Qwen/Qwen3-8B
LLM_API_KEY=local-dev-key
LLM_TIMEOUT_SEC=60

TTS_LANGUAGE=KR
TTS_SPEAKER_ID=
TTS_OUTPUT_DIR=backend/app/static/tts

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

